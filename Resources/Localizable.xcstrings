    "Select an installed Node environment in Tools or follow the official guide.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Select an installed Node environment in Tools or follow the official guide."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在工具中选择已安装的 Node 环境，或查看官方指引。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在工具中選擇已安裝的 Node 環境，或查看官方指南。"}}}},
