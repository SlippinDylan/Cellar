    "%@ of %@ Items Can Be Installed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ of %@ Items Can Be Installed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 项可安装，共 %@ 项"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 項可安裝，共 %@ 項"}}}},
