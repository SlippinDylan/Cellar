    "Uninstall finished, but the environment could not be refreshed. Use Refresh to check the current state." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uninstall finished, but the environment could not be refreshed. Use Refresh to check the current state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卸载已结束，但无法刷新环境。请刷新以检查当前状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除安裝已結束，但無法重新整理環境。請重新整理以檢查目前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストールは完了しましたが、環境を再読み込みできませんでした。再読み込みして現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거는 완료되었지만 환경을 새로 고칠 수 없습니다. 새로 고침으로 현재 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Deinstallation wurde abgeschlossen, aber die Umgebung konnte nicht neu geladen werden. Lade die Ansicht neu, um den aktuellen Zustand zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désinstallation est terminée, mais l’environnement n’a pas pu être actualisé. Actualisez pour vérifier l’état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La desinstalación terminó, pero no se pudo actualizar la información del entorno. Usa Actualizar información para comprobar el estado actual."
          }
        }
      }
    },
