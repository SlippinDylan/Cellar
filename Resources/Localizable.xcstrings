    "Logs contain redacted task summaries. Raw terminal output stays in session diagnostics." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs contain redacted task summaries. Raw terminal output stays in session diagnostics."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志保存去敏后的任务摘要，原始终端输出仅保留在当前会话诊断中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日誌儲存去敏後的作業摘要，原始終端機輸出僅保留於目前階段的診斷中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログには機密情報を伏せたタスク概要を保存します。ターミナルの生の出力はセッションの診断情報にのみ保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그에는 민감한 정보를 가린 작업 요약이 포함됩니다. 원시 터미널 출력은 세션 진단 정보에만 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle enthalten bereinigte Aufgabenzusammenfassungen. Unveränderte Terminalausgaben verbleiben in der Sitzungsdiagnose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux contiennent des résumés de tâches dont les informations sensibles ont été masquées. Les sorties brutes du terminal restent dans les diagnostics de session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros contienen resúmenes de tareas con los datos sensibles ocultos. La salida sin procesar del terminal permanece en el diagnóstico de la sesión."
          }
        }
      }
    },
    "Logs could not be saved. Check available storage and folder permissions, then retry." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs could not be saved. Check available storage and folder permissions, then retry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存日志，请检查可用空间和文件夹权限后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存日誌，請檢查可用空間和檔案夾權限後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを保存できませんでした。空き容量とフォルダのアクセス権を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 저장할 수 없습니다. 사용 가능한 저장 공간과 폴더 권한을 확인한 다음 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle konnten nicht gespeichert werden. Prüfe freien Speicherplatz und Ordnerberechtigungen und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les journaux. Vérifiez l’espace disponible et les permissions du dossier, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los registros. Comprueba el espacio disponible y los permisos de la carpeta; después, inténtalo de nuevo."
          }
        }
      }
    },
    "Logs could not be saved. Check storage and permissions in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs could not be saved. Check storage and permissions in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存日志，请在设置中检查存储空间和权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存日誌，請在設定中檢查儲存空間和權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを保存できませんでした。設定でストレージとアクセス権を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 저장할 수 없습니다. 설정에서 저장 공간과 권한을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle konnten nicht gespeichert werden. Prüfe Speicherplatz und Berechtigungen in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les journaux. Vérifiez le stockage et les permissions dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los registros. Comprueba el almacenamiento y los permisos en Ajustes."
          }
        }
      }
    },
    "Older logs are removed automatically. Each file is limited to 10 MB; total storage is limited to 50 MB." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Older logs are removed automatically. Each file is limited to 10 MB; total storage is limited to 50 MB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过期日志会自动移除。单个文件上限 10 MB，总占用上限 50 MB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過期日誌會自動移除。單個檔案上限 10 MB，總用量上限 50 MB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いログは自動的に削除されます。各ファイルは最大 10 MB、合計容量は最大 50 MB です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 로그는 자동으로 제거됩니다. 파일 하나당 최대 10 MB, 전체 저장 용량은 최대 50 MB입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Protokolle werden automatisch entfernt. Jede Datei ist auf 10 MB begrenzt, der gesamte Speicherbedarf auf 50 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens journaux sont supprimés automatiquement. Chaque fichier est limité à 10 Mo ; l’ensemble est limité à 50 Mo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros antiguos se eliminan automáticamente. Cada archivo tiene un límite de 10 MB y el almacenamiento total se limita a 50 MB."
          }
        }
      }
    },
    "Only the selected level and higher are saved. Changes apply immediately." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the selected level and higher are saved. Changes apply immediately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅保存所选等级及以上的日志，修改后立即生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅儲存所選等級及以上的日誌，修改後立即生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したレベル以上のログだけを保存します。変更はすぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 수준 이상의 로그만 저장됩니다. 변경 사항은 즉시 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ausgewählte Stufe und höhere werden gespeichert. Änderungen gelten sofort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls le niveau sélectionné et les niveaux supérieurs sont enregistrés. Les modifications prennent effet immédiatement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan los mensajes del nivel seleccionado y de los niveles superiores. Los cambios se aplican inmediatamente."
          }
        }
      }
    },
