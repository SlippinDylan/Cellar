        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置无法完整检查，可能仍有其他文件残留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分位置無法完整檢查，可能仍有其他檔案殘留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の場所は完全に調べられませんでした。ほかにもファイルが残っている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 위치를 완전히 검사하지 못했습니다. 추가 파일이 남아 있을 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Speicherorte konnten nicht vollständig geprüft werden. Weitere Dateien können zurückbleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains emplacements n’ont pas pu être entièrement examinés. D’autres fichiers peuvent subsister."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron inspeccionar por completo algunas ubicaciones. Pueden quedar otros archivos."
          }
        }
      }
    },
    "Homebrew’s uninstaller may require separate administrator authorization.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew’s uninstaller may require separate administrator authorization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 的卸载程序可能需要另外取得管理员授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 的解除安裝程式可能需要另外取得管理員授權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew のアンインストーラが、別途管理者認証を要求する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 제거 프로그램에서 별도의 관리자 인증을 요구할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
