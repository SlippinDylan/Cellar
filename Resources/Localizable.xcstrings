    "Move the listed completion files and historical backups into .zsh. The current .zshrc is backed up before its managed completion location changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the listed completion files and historical backups into .zsh. The current .zshrc is backed up before its managed completion location changes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将列出的补全文件和历史备份移入 .zsh。修改受管理的补全路径前会备份当前 .zshrc。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將列出的補完檔案和歷史備份移入 .zsh。修改受管理的補完路徑前會備份目前的 .zshrc。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧の補完ファイルと過去のバックアップを .zsh に移動します。管理対象の補完先を変更する前に、現在の .zshrc をバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나열된 자동 완성 파일과 이전 백업을 .zsh로 이동합니다. 관리되는 자동 완성 위치를 변경하기 전에 현재 .zshrc를 백업합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgeführten Vervollständigungsdateien und alten Sicherungen nach .zsh verschieben. Die aktuelle .zshrc wird gesichert, bevor ihr verwalteter Speicherort für Vervollständigungen geändert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les fichiers de complétion et les sauvegardes historiques répertoriés dans .zsh. Le .zshrc actuel est sauvegardé avant de modifier l’emplacement de complétion géré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover los archivos de autocompletado y las copias históricas indicados a .zsh. Se crea una copia del .zshrc actual antes de cambiar la ubicación de autocompletado gestionada."
          }
        }
      }
    },
    "Move the listed Zsh completion files and historical backups into .zsh. Back up .zshrc before updating its managed completion location." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the listed Zsh completion files and historical backups into .zsh. Back up .zshrc before updating its managed completion location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将列出的 Zsh 补全文件和历史备份移入 .zsh。更新受管理的补全路径前会备份 .zshrc。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將列出的 Zsh 補完檔案和歷史備份移入 .zsh。更新受管理的補完路徑前會備份 .zshrc。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧の Zsh 補完ファイルと過去のバックアップを .zsh に移動します。管理対象の補完先を更新する前に .zshrc をバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나열된 Zsh 자동 완성 파일과 이전 백업을 .zsh로 이동합니다. 관리되는 자동 완성 위치를 업데이트하기 전에 .zshrc를 백업합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgeführten Zsh-Vervollständigungsdateien und alten Sicherungen nach .zsh verschieben. .zshrc sichern, bevor ihr verwalteter Speicherort für Vervollständigungen aktualisiert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les fichiers de complétion Zsh et les sauvegardes historiques répertoriés dans .zsh. Sauvegarder .zshrc avant de modifier l’emplacement de complétion géré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover los archivos de autocompletado de Zsh y las copias históricas indicados a .zsh. Crear una copia de .zshrc antes de actualizar la ubicación de autocompletado gestionada."
          }
        }
      }
    },
