          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar 不负责安装 Homebrew。安装后刷新即可读取状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
