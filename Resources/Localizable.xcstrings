  "strings": {
    "This package uses another Registry. Search its full @scope/name to use that source before installing.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This package uses another Registry. Search its full @scope/name to use that source before installing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此软件包使用另一个 Registry。安装前请搜索完整的 @scope/name，以使用对应来源。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此套件使用另一個 Registry。安裝前請搜尋完整的 @scope/name，以使用對應來源。"}}}},
