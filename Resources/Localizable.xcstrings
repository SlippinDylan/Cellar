    "Application data will be permanently removed, except files marked as kept. This cannot be rolled back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application data will be permanently removed, except files marked as kept. This cannot be rolled back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除标记为保留的文件外，应用数据将被永久删除，此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除標記為保留的檔案外，應用程式資料將被永久刪除，此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持対象のファイルを除き、アプリケーションデータは完全に削除されます。元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지로 표시된 파일을 제외한 앱 데이터가 영구적으로 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwendungsdaten werden dauerhaft entfernt, mit Ausnahme der als beibehalten markierten Dateien. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de l’application seront supprimées définitivement, sauf les fichiers indiqués comme conservés. Cette opération est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la aplicación se eliminarán permanentemente, salvo los archivos marcados para conservar. Esta operación no se puede deshacer."
          }
        }
      }
    },
