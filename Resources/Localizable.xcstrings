  "Protected directory access could not be verified. Check Full Disk Access in System Settings.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Protected directory access could not be verified. Check Full Disk Access in System Settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法验证受保护目录的访问。请检查系统设置中的完全磁盘访问权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "無法驗證受保護目錄的存取。請檢查系統設定中的完整磁碟存取權。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "保護されたディレクトリへのアクセスを確認できませんでした。システム設定でフルディスクアクセスを確認してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "보호된 디렉토리에 대한 접근을 확인할 수 없습니다. 시스템 설정에서 전체 디스크 접근 권한을 확인하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der Zugriff auf geschützte Verzeichnisse konnte nicht überprüft werden. Prüfe den Festplattenvollzugriff in den Systemeinstellungen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’accès au dossier protégé n’a pas pu être vérifié. Vérifiez l’accès complet au disque dans Réglages Système."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "No se pudo verificar el acceso al directorio protegido. Comprueba el acceso total al disco en Ajustes del Sistema."
        }
      }
    }
  },


