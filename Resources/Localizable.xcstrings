    "Installation runs one item at a time. A failure does not stop other items. Completed installations cannot be rolled back." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation runs one item at a time. A failure does not stop other items. Completed installations cannot be rolled back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装将逐项执行。单项失败不会停止其他项目。已完成的安装无法回滚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安裝將逐項執行。單項失敗不會停止其他項目。已完成的安裝無法回復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールは 1 件ずつ実行します。失敗してもほかの項目は続行します。完了したインストールは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 하나씩 설치합니다. 실패해도 다른 항목은 계속 진행합니다. 완료된 설치는 되돌릴 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation verarbeitet die Einträge nacheinander. Ein Fehler stoppt die übrigen Einträge nicht. Abgeschlossene Installationen können nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sont installés un par un. Un échec n’arrête pas les autres éléments. Les installations terminées ne peuvent pas être annulées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos se instalan de uno en uno. Un fallo no detiene los demás. Las instalaciones completadas no se pueden deshacer."
          }
        }
      }
    },
