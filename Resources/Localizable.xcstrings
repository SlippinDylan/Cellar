    "诊断输出超过保留上限，显示内容已截断。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic output exceeded the retention limit; the displayed content has been truncated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断输出超过保留上限，显示内容已截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷輸出超過保留上限，顯示內容已截斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断出力が保持上限を超えたため、表示内容を切り詰めました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 출력이 보관 한도를 초과하여 표시 내용이 잘렸습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnoseausgabe hat die Aufbewahrungsgrenze überschritten; der angezeigte Inhalt wurde gekürzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie de diagnostic a dépassé la limite de conservation ; le contenu affiché a été tronqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida de diagnóstico superó el límite de conservación; el contenido mostrado se ha truncado."
          }
        }
      }
    },
