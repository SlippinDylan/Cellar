    "Try another search or choose a different scope.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try another search or choose a different scope."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请尝试其他搜索词，或选择其他范围。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請嘗試其他搜尋詞，或選擇其他範圍。"}}}},
    "All": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"All"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"全部"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"全部"}}}},
    "Choose up to 100 items from one provider and type in one Node environment.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose up to 100 items from one provider and type in one Node environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请选择同一来源和类型的项目，最多 100 项；npm 和 Node 项目须属于同一 Node 环境。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請選擇同一來源和類型的項目，最多 100 項；npm 和 Node 項目須屬於同一 Node 環境。"}}}},
    "Current or default Node versions and protected packages cannot be removed. Choose another target.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Current or default Node versions and protected packages cannot be removed. Choose another target."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法移除当前或默认 Node 版本及受保护的软件包。请选择其他目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法移除目前或預設 Node 版本及受保護的套件。請選擇其他目標。"}}}},
    "Cannot prepare this uninstall. Refresh and check the selected targets.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cannot prepare this uninstall. Refresh and check the selected targets."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法准备卸载。请刷新并检查所选目标。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法準備解除安裝。請重新整理並檢查所選目標。"}}}},
    "Uninstall could not start because the confirmed state is no longer valid. Refresh and try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall could not start because the confirmed state is no longer valid. Refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"确认的状态已失效，无法开始卸载。请刷新后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"確認的狀態已失效，無法開始解除安裝。請重新整理後再試。"}}}},
    "Uninstall Software": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall Software"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卸载软件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"解除安裝軟體"}}}},
    "These items will be removed. This cannot be rolled back. Items run in order; a failure does not undo completed items.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"These items will be removed. This cannot be rolled back. Items run in order; a failure does not undo completed items."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将移除以下项目，无法回滚。项目按顺序执行，失败不会撤销已完成的项目。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將移除以下項目，無法復原。項目依序執行，失敗不會撤銷已完成的項目。"}}}},
    "Standard Cask Uninstall": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Standard Cask Uninstall"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标准 Cask 卸载"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"標準 Cask 解除安裝"}}}},
    "Homebrew removes the listed app artifacts. Preferences and support files may remain.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Homebrew removes the listed app artifacts. Preferences and support files may remain."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 会移除列出的应用文件，偏好设置和支持文件可能保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 會移除列出的應用程式檔案，偏好設定和支援檔案可能保留。"}}}},
    "Each selected Node installation and its global npm packages will be removed. Current and default Node versions are protected.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Each selected Node installation and its global npm packages will be removed. Current and default Node versions are protected."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将移除每个所选 Node 安装及其 npm 全局包。当前和默认 Node 版本受到保护。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將移除每個所選 Node 安裝及其 npm 全域套件。目前和預設 Node 版本受到保護。"}}}},
    "Uninstall": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卸载"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"解除安裝"}}}},
