          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향후 nvm 세션에서 이 버전을 사용합니다. 이미 열린 터미널은 변경되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
