    "Updates could not be checked. Local information is still available." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates could not be checked. Local information is still available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查更新，本机信息仍可查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查更新，本機資訊仍可查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新を確認できませんでした。ローカル情報は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 확인할 수 없습니다. 로컬 정보는 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates konnten nicht geprüft werden. Lokale Informationen sind weiterhin verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rechercher les mises à jour. Les informations locales restent disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar las actualizaciones. La información local sigue disponible."
          }
        }
      }
    },
    "Updates finished, but an environment could not be refreshed. Item results are retained. Use Refresh to check the current state." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates finished, but an environment could not be refreshed. Item results are retained. Use Refresh to check the current state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新已结束，但无法刷新某个环境。已保留逐项结果。请刷新以检查当前状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新已結束，但無法重新整理某個環境。已保留逐項結果。請重新整理以檢查目前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新は完了しましたが、一部の環境を再読み込みできませんでした。項目ごとの結果は保持されています。再読み込みして現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 완료되었지만 환경을 새로 고칠 수 없습니다. 항목별 결과는 유지됩니다. 새로 고침으로 현재 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Updates wurden abgeschlossen, aber eine Umgebung konnte nicht neu geladen werden. Einzelergebnisse bleiben erhalten. Lade die Ansicht neu, um den aktuellen Zustand zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour sont terminées, mais un environnement n’a pas pu être actualisé. Les résultats individuels sont conservés. Actualisez pour vérifier l’état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones terminaron, pero no se pudo actualizar la información de un entorno. Los resultados de cada elemento se conservan. Usa Actualizar información para comprobar el estado actual."
          }
        }
      }
    },
