    "Node and npm could not be refreshed. Previously loaded items may be out of date. Use Refresh to retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node and npm could not be refreshed. Previously loaded items may be out of date. Use Refresh to retry."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法刷新 Node 和 npm，已加载的项目可能不是最新状态。请刷新重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法重新整理 Node 和 npm，已載入的項目可能不是最新狀態。請重新整理再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Node と npm を再読み込みできませんでした。取得済みの項目は古い可能性があります。再読み込みして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Node와 npm을 새로 고칠 수 없습니다. 이전에 불러온 항목이 오래되었을 수 있습니다. 새로 고침으로 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Node- und npm-Daten konnten nicht neu geladen werden. Zuvor geladene Einträge sind möglicherweise veraltet. Lade die Ansicht neu, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’actualiser Node et npm. Les éléments déjà chargés peuvent être obsolètes. Actualisez pour réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar la información de Node y npm. Los elementos cargados pueden estar desactualizados. Actualiza la información para reintentar."
          }
        }
      }
    },
