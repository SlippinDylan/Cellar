    "Uninstall finished, but the environment could not be refreshed. Use Refresh to check the current state.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Uninstall finished, but the environment could not be refreshed. Use Refresh to check the current state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卸载已结束，但无法刷新环境。请刷新以检查当前状态。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"解除安裝已結束，但無法重新整理環境。請重新整理以檢查目前狀態。"}}}},
