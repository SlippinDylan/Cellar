    "最多 100 项。空行会忽略，重复项只保留第一次出现。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 100 items. Blank lines are ignored, and only the first occurrence of each duplicate is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 100 项。空行会忽略，重复项只保留第一次出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 100 項。空白行會忽略，重複項目只保留第一次出現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大 100 件です。空行は無視し、重複項目は最初の 1 件だけを残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 100개 항목입니다. 빈 줄은 무시하고 중복 항목은 처음 나타난 항목만 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 100 Einträge. Leerzeilen werden ignoriert und bei Duplikaten bleibt nur das erste Vorkommen erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 100 éléments. Les lignes vides sont ignorées et seule la première occurrence de chaque doublon est conservée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 100 elementos. Se ignoran las líneas vacías y solo se conserva la primera aparición de cada duplicado."
          }
        }
      }
    },
