    "Some search results could not be loaded." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some search results could not be loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分搜索结果无法加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分搜尋結果無法載入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の検索結果を読み込めませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 검색 결과를 불러오지 못했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Suchergebnisse konnten nicht geladen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains résultats de recherche n’ont pas pu être chargés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar algunos resultados de búsqueda."
          }
        }
      }
    },
  "This Node installation is readable. npm package changes and search require a supported nvm installation.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This Node installation is readable. npm package changes and search require a supported nvm installation."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "可以读取此 Node 安装的信息。npm 软件包修改和搜索需要受支持的 nvm 安装。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "可以讀取此 Node 安裝的資訊。npm 套件變更和搜尋需要支援的 nvm 安裝。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "この Node インストールの情報は読み取れます。npm パッケージの変更と検索には、対応する nvm インストールが必要です。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 Node 설치의 정보는 읽을 수 있습니다. npm 패키지 변경과 검색에는 지원되는 nvm 설치가 필요합니다."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Diese Node-Installation kann gelesen werden. Änderungen und Suche nach npm-Paketen erfordern eine unterstützte nvm-Installation."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les informations de cette installation Node sont lisibles. La modification et la recherche de paquets npm nécessitent une installation nvm prise en charge."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Se puede leer esta instalación de Node. Los cambios y la búsqueda de paquetes npm requieren una instalación de nvm compatible."
        }
      }
    }
  },
  "Use a credential-free HTTPS Registry URL, or HTTP on localhost, 127.0.0.1, or [::1]. Other addresses are unsupported.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Use a credential-free HTTPS Registry URL, or HTTP on localhost, 127.0.0.1, or [::1]. Other addresses are unsupported."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请使用不含凭证的 HTTPS 软件源地址，或 localhost、127.0.0.1、[::1] 上的 HTTP 地址。不支持其他地址。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "請使用不含憑證的 HTTPS 套件來源網址，或 localhost、127.0.0.1、[::1] 上的 HTTP 網址。不支援其他位址。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "認証情報を含まない HTTPS レジストリ URL、または localhost、127.0.0.1、[::1] の HTTP URL を使用してください。他のアドレスには対応していません。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "인증 정보가 없는 HTTPS 레지스트리 URL 또는 localhost, 127.0.0.1, [::1]의 HTTP URL을 사용하세요. 다른 주소는 지원하지 않습니다."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Verwende eine HTTPS-Registry-URL ohne Zugangsdaten oder HTTP auf localhost, 127.0.0.1 oder [::1]. Andere Adressen werden nicht unterstützt."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Utilisez une URL de registre HTTPS sans identifiants, ou HTTP sur localhost, 127.0.0.1 ou [::1]. Les autres adresses ne sont pas prises en charge."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Usa una URL de registro HTTPS sin credenciales, o HTTP en localhost, 127.0.0.1 o [::1]. No se admiten otras direcciones."
        }
      }
    }
  },
  "The item changed. Review it again before retrying." : {
    "localizations" : {
      "en" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "The item changed. Review it again before retrying."
        }
      },
      "zh-Hans" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "项目已变化，请重新检查后再试。"
        }
      },
      "zh-Hant" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "項目已變更，請重新檢查後再試。"
        }
      },
      "ja" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "項目が変更されました。確認してから再試行してください。"
        }
      },
      "ko" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "항목이 변경되었습니다. 다시 확인한 후 재시도하세요."
        }
      },
      "de" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Das Objekt wurde geändert. Prüfe es vor einem erneuten Versuch."
        }
      },
      "fr" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "L’élément a changé. Vérifiez-le avant de réessayer."
        }
      },
      "es" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "El elemento cambió. Revísalo antes de reintentar."
        }
      }
    }
  },
  "Some contents may have been removed. Review the remaining files before retrying." : {
    "localizations" : {
      "en" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Some contents may have been removed. Review the remaining files before retrying."
        }
      },
      "zh-Hans" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "部分内容可能已移除，请检查剩余文件后再试。"
        }
      },
      "zh-Hant" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "部分內容可能已移除，請檢查剩餘檔案後再試。"
        }
      },
      "ja" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "一部の内容が削除された可能性があります。残りのファイルを確認してから再試行してください。"
        }
      },
      "ko" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "일부 내용이 제거되었을 수 있습니다. 남은 파일을 확인한 후 재시도하세요."
        }
      },
      "de" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Einige Inhalte wurden möglicherweise entfernt. Prüfe die übrigen Dateien vor einem erneuten Versuch."
        }
      },
      "fr" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Certains contenus ont peut-être été supprimés. Vérifiez les fichiers restants avant de réessayer."
        }
      },
      "es" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Puede haberse eliminado parte del contenido. Revisa los archivos restantes antes de reintentar."
        }
      }
    }
  },
