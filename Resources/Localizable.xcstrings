    "Cellar keeps the login shell unchanged. Configuration changes are backed up and checked for syntax." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar keeps the login shell unchanged. Configuration changes are backed up and checked for syntax."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 保持登录 Shell 不变，修改配置前会备份并检查语法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 會保持登入 Shell 不變，修改設定前會備份並檢查語法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar はログインシェルを変更しません。設定変更時にはバックアップを作成し、構文を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar는 로그인 셸을 변경하지 않습니다. 설정 변경 시 백업을 만들고 구문을 검사합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar ändert die Anmeldeshell nicht. Konfigurationsänderungen werden gesichert und auf Syntaxfehler geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar ne modifie pas le shell de connexion. Les changements de configuration sont sauvegardés et leur syntaxe est vérifiée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar no cambia el shell de inicio de sesión. Se crean copias de seguridad de los cambios de configuración y se comprueba su sintaxis."
          }
        }
      }
    },
