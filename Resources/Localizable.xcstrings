    "History could not be saved. Check available storage and permissions, then retry saving history." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "History could not be saved. Check available storage and permissions, then retry saving history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存历史。请检查可用存储空间和权限，然后重试保存历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存歷史。請檢查可用儲存空間及權限，然後重試儲存歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を保存できませんでした。空き容量とアクセス権を確認し、保存を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록을 저장할 수 없습니다. 사용 가능한 저장 공간과 권한을 확인한 다음 기록 저장을 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht gespeichert werden. Prüfe freien Speicherplatz und Berechtigungen und versuche erneut, den Verlauf zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’historique. Vérifiez l’espace disponible et les permissions, puis réessayez de l’enregistrer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el historial. Comprueba el espacio disponible y los permisos, y vuelve a guardarlo."
          }
        }
      }
    },
