        }
      },
      "de" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Ein vorheriges Objekt ist fehlgeschlagen. Prüfe die übrigen Objekte vor einem erneuten Versuch."
        }
      },
      "fr" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Un élément précédent a échoué. Vérifiez les éléments restants avant de réessayer."
        }
      },
      "es" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Falló un elemento anterior. Revisa los elementos restantes antes de reintentar."
        }
      }
    }
  },
