    "Settings change the user layer. The effective Registry may come from a higher priority layer." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings change the user layer. The effective Registry may come from a higher priority layer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置修改用户配置层，当前生效 Registry 可能来自更高优先级的配置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定會修改使用者設定層，目前生效的 Registry 可能來自更高優先順序的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はユーザー層を変更します。有効なレジストリは、優先順位の高い層に由来する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 계층의 설정을 변경합니다. 실제 적용되는 레지스트리는 우선순위가 높은 계층에서 가져올 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen ändern die Benutzerebene. Die wirksame Registry kann aus einer Ebene mit höherer Priorität stammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages modifient la couche utilisateur. Le registre effectif peut provenir d’une couche de priorité supérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes modifican la capa de usuario. El registro efectivo puede proceder de una capa de mayor prioridad."
          }
        }
      }
    },
