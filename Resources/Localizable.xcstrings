    "Installer Opened. Complete or cancel the installation in macOS Installer, then recheck. Opening Installer does not confirm installation.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installer Opened. Complete or cancel the installation in macOS Installer, then recheck. Opening Installer does not confirm installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已打开安装器。在 macOS 安装器中完成或取消安装后，再次检查。打开安装器不代表安装成功。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已開啟安裝程式。在 macOS 安裝程式中完成或取消安裝後，再次檢查。開啟安裝程式不代表安裝成功。"}}}},
    "Finished in Installer — Recheck": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Finished in Installer — Recheck"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已结束系统安装 — 再次检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已結束系統安裝 — 再次檢查"}}}},
