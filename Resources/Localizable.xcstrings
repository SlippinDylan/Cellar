  "An earlier item failed. Review the remaining items before retrying." : {
    "localizations" : {
      "en" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "An earlier item failed. Review the remaining items before retrying."
        }
      },
      "zh-Hans" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "前一项目处理失败，请检查剩余项目后再试。"
        }
      },
      "zh-Hant" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "前一項目處理失敗，請檢查剩餘項目後再試。"
        }
      },
      "ja" : {
        "stringUnit" : {
