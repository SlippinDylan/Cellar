    "Completed tasks appear here. Cellar keeps the latest 100 summaries across launches." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completed tasks appear here. Cellar keeps the latest 100 summaries across launches."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已结束的任务显示在这里。Cellar 会跨启动保留最近 100 条摘要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已結束的任務會顯示在這裡。Cellar 會在重新啟動後保留最近 100 筆摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したタスクがここに表示されます。直近 100 件の概要は、Cellar を再起動しても保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 작업이 여기에 표시됩니다. Cellar는 앱을 다시 실행한 뒤에도 최근 요약 100개를 유지합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Aufgaben erscheinen hier. Cellar bewahrt die letzten 100 Zusammenfassungen über Neustarts hinweg auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches terminées apparaissent ici. Cellar conserve les 100 derniers résumés d’un lancement à l’autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las tareas completadas. Cellar conserva los últimos 100 resúmenes entre inicios."
          }
        }
      }
    },
