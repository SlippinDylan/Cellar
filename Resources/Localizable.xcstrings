    "Uninstall could not start because the confirmed state is no longer valid. Refresh and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uninstall could not start because the confirmed state is no longer valid. Refresh and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认的状态已失效，无法开始卸载。请刷新后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認的狀態已失效，無法開始解除安裝。請重新整理後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みの状態が無効になったため、アンインストールを開始できませんでした。再読み込みして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 상태가 더 이상 유효하지 않아 제거를 시작할 수 없습니다. 새로 고침 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Deinstallation konnte nicht starten, weil der bestätigte Zustand nicht mehr gültig ist. Lade die Ansicht neu und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désinstallation n’a pas pu démarrer car l’état confirmé n’est plus valide. Actualisez et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La desinstalación no pudo iniciarse porque el estado confirmado ya no es válido. Actualiza la información e inténtalo de nuevo."
          }
        }
      }
    },
