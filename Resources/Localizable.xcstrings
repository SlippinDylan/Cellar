            "value": "Shared or Protected Files Will Be Kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留共享或受保护的文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留共享或受保護的檔案"
          }
        },
