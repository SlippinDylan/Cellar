    "一行一个名称；Formula 与 Cask 分别生成独立计划。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one name per line. Formula and Cask each get a separate plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一个名称；Formula 与 Cask 分别生成独立计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行一個名稱；Formula 與 Cask 分別產生獨立計畫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 名を入力してください。Formula と Cask は別々の計画で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 이름 하나를 입력하세요. Formula와 Cask는 각각 별도 계획으로 처리됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen Namen pro Zeile ein. Formula und Cask erhalten jeweils einen eigenen Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom par ligne. Formula et Cask reçoivent chacun un plan distinct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un nombre por línea. Formula y Cask tendrán planes separados."
          }
        }
      }
