  "macOS or file permissions prevent reading this path. Check permissions and, if needed, Full Disk Access for Cellar in System Settings.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "macOS or file permissions prevent reading this path. Check permissions and, if needed, Full Disk Access for Cellar in System Settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "macOS 隐私保护或文件权限阻止了读取。请检查文件权限；如有需要，在系统设置中授予 Cellar 完全磁盘访问权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "macOS 隱私保護或檔案權限阻止了讀取。請檢查檔案權限；如有需要，請在系統設定中授予 Cellar 完整磁碟存取權。"
        }
