          }
        }
      }
    },
    "Zsh files may have moved, but the shell configuration changed unexpectedly. It was not overwritten. Review diagnostics before trying again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh files may have moved, but the shell configuration changed unexpectedly. It was not overwritten. Review diagnostics before trying again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh 文件可能已移动，但 Shell 配置发生了意外变化，未覆盖配置。请查看诊断后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh 檔案可能已移動，但 Shell 設定發生了非預期變更，未覆寫設定。請查看診斷後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh ファイルは移動された可能性がありますが、シェル設定が予期せず変更されました。設定は上書きしていません。診断情報を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh 파일이 이동되었을 수 있지만 셸 설정이 예기치 않게 변경되었습니다. 덮어쓰지 않았습니다. 다시 시도하기 전에 진단 정보를 검토하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh-Dateien wurden möglicherweise verschoben, aber die Shell-Konfiguration hat sich unerwartet geändert. Sie wurde nicht überschrieben. Prüfe die Diagnose, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers Zsh ont peut-être été déplacés, mais la configuration du shell a changé de manière inattendue. Elle n’a pas été écrasée. Consultez les diagnostics avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que los archivos de Zsh se hayan movido, pero la configuración del shell cambió inesperadamente. No se sobrescribió. Revisa el diagnóstico antes de intentarlo de nuevo."
          }
        }
      }
    },
    "Zsh files were moved, but syntax validation failed. The previous shell configuration and attributes were restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh files were moved, but syntax validation failed. The previous shell configuration and attributes were restored."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh 文件已移动，但语法检查失败。已恢复之前的 Shell 配置及文件属性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh 檔案已移動，但語法檢查失敗。已還原先前的 Shell 設定及檔案屬性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh ファイルは移動されましたが、構文検証に失敗しました。以前のシェル設定と属性を復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh 파일을 이동했지만 구문 검사에 실패했습니다. 이전 셸 설정과 속성을 복원했습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zsh-Dateien wurden verschoben, aber die Syntaxprüfung ist fehlgeschlagen. Die vorherige Shell-Konfiguration und ihre Attribute wurden wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers Zsh ont été déplacés, mais la validation de la syntaxe a échoué. La configuration précédente du shell et ses attributs ont été restaurés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de Zsh se movieron, pero la validación de sintaxis falló. Se restauraron la configuración anterior del shell y sus atributos."
          }
        }
      }
    },
