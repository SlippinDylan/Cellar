    "Loading Installed Software…": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Loading Installed Software…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在加载已安装软件…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在載入已安裝軟體…"}}}},
