    "Install nvm using the official guide, then refresh the local environment.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Install nvm using the official guide, then refresh the local environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"按照官方指引安装 nvm，然后刷新本机环境。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按照官方指南安裝 nvm，然後重新整理本機環境。"}}}},
