    "Update could not start. Refresh and check the selected packages, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update could not start. Refresh and check the selected packages, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法开始更新。请刷新并检查所选软件包后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開始更新。請重新整理並檢查所選套件後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新を開始できませんでした。再読み込みし、選択したパッケージを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 시작할 수 없습니다. 새로 고침 후 선택한 패키지를 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht gestartet werden. Lade die Ansicht neu, prüfe die ausgewählten Pakete und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour n’a pas pu démarrer. Actualisez et vérifiez les paquets sélectionnés, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización no pudo iniciarse. Actualiza la información y comprueba los paquetes seleccionados; después, inténtalo de nuevo."
          }
        }
      }
    },
