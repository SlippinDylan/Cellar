{
  "sourceLanguage" : "en",
  "strings" : {
  "Administrator cleanup did not finish. Check authorization and file permissions.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Administrator cleanup did not finish. Check authorization and file permissions."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "管理员清理未完成。请检查授权和文件权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "管理員清理未完成。請檢查授權和檔案權限。"
        }
      }
    }
  },
  "The application is still running. Quit it before continuing.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The application is still running. Quit it before continuing."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "应用仍在运行。请先退出应用，再继续处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "應用程式仍在執行。請先結束應用程式，再繼續處理。"
        }
      }
    }
  },
  "Homebrew removed the package. Quit its remaining processes, then handle this path manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Quit its remaining processes, then handle this path manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请先退出其仍在运行的进程，再到访达手动处理此路径。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請先結束其仍在執行的程序，再到 Finder 手動處理此路徑。"
        }
      }
    }
  },
  "Homebrew removed the package. Check authorization and file permissions, then handle this path manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Check authorization and file permissions, then handle this path manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请检查授权和文件权限，再到访达手动处理此路径。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請檢查授權和檔案權限，再到 Finder 手動處理此路徑。"
        }
      }
    }
  },
  "Homebrew removed the package. Confirm this path’s ownership and current state before handling it manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Confirm this path’s ownership and current state before handling it manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请先确认此路径的归属和当前状态，再到访达手动处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請先確認此路徑的歸屬和目前狀態，再到 Finder 手動處理。"
        }
      }
    }
  },
  "Homebrew removed the package, but this path remains. Review it before handling it manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package, but this path remains. Review it before handling it manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包，但此路径仍然存在。请先检查，再到访达手动处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件，但此路徑仍然存在。請先檢查，再到 Finder 手動處理。"
        }
      }
    }
  },

  "This data may be shared or its ownership is unclear. Check the impact before removing it manually.": {
  "localizations": {
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "This data may be shared or its ownership is unclear. Check the impact before removing it manually."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "此数据可能共享，或无法确认归属。手动移除前请先确认影响。"
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "此資料可能共用，或無法確認歸屬。手動移除前請先確認影響。"
      }
    }
  }
},
  "File ownership could not be fully verified. These files were kept.": {
  "localizations": {
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "File ownership could not be fully verified. These files were kept."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "未能完整验证文件归属，已保留这些文件。"
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "未能完整驗證檔案歸屬，已保留這些檔案。"
      }
    }
  }
},
  "The application is still running. Quit it, then review the uninstallation again.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The application is still running. Quit it, then review the uninstallation again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "应用仍在运行，请先退出应用，再重新检查卸载清单。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "App 仍在執行，請先結束 App，再重新檢查解除安裝清單。"
        }
      }
    }
  },
  "Inspect protected application data during uninstallation.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Inspect protected application data during uninstallation."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "用于卸载时分析受保护的应用数据。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "用於解除安裝時分析受保護的 App 資料。"
        }
      }
    }
  },
  "Access is blocked. Check Full Disk Access in System Settings.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Access is blocked. Check Full Disk Access in System Settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "访问受限，请在系统设置中检查完全磁盘访问权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "存取受限，請在系統設定中檢查完整磁碟存取權限。"
        }
      }
    }
  },

  "Drag Cellar into the Full Disk Access list in System Settings, then turn on its switch.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Drag Cellar into the Full Disk Access list in System Settings, then turn on its switch."
