      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "将 Cellar 拖入系统设置的“完全磁盘访问权限”列表，再打开开关。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "將 Cellar 拖入系統設定的「完整磁碟存取權限」列表，再開啟開關。"
        }
      }
    }
  },
