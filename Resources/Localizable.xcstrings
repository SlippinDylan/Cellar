{
  "sourceLanguage" : "en",
  "strings" : {
    "The task exceeded its time limit. Refresh to check the current state before trying again." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task exceeded its time limit. Refresh to check the current state before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已超时。请刷新以检查当前状态，然后再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務已逾時。請重新整理以檢查目前狀態，再重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが制限時間を超えました。再試行する前に、更新して現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 제한 시간을 초과했습니다. 다시 시도하기 전에 새로 고침하여 현재 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe hat das Zeitlimit überschritten. Aktualisiere, um den aktuellen Zustand zu prüfen, bevor du es erneut versuchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a dépassé le délai imparti. Actualisez pour vérifier l’état actuel avant de réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea superó el límite de tiempo. Actualiza para comprobar el estado actual antes de volver a intentarlo."
          }
        }
      }
    },
    "These installed Formula packages use this software. Cask dependents are not listed. Homebrew checks the installed versions and may refuse removal." : {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These installed Formula packages use this software. Cask dependents are not listed. Homebrew checks the installed versions and may refuse removal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些已安装的 Formula 使用此软件。此处不列出依赖它的 Cask。Homebrew 会检查已安装版本，并可能拒绝卸载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些已安裝的 Formula 使用此軟體。此處不列出依賴它的 Cask。Homebrew 會檢查已安裝版本，並可能拒絕解除安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのインストール済み Formula はこのソフトウェアを使用します。依存する Cask は表示していません。Homebrew はインストール済みバージョンを確認し、削除を拒否する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치된 Formula 패키지는 이 소프트웨어를 사용합니다. 의존하는 Cask는 표시되지 않습니다. Homebrew는 설치된 버전을 확인하고 제거를 거부할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese installierten Formula-Pakete verwenden diese Software. Abhängige Casks werden nicht aufgeführt. Homebrew prüft die installierten Versionen und kann die Entfernung verweigern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces Formula installées utilisent ce logiciel. Les Cask dépendants ne sont pas répertoriés. Homebrew vérifie les versions installées et peut refuser la suppression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas Formula instaladas usan este software. No se muestran los Cask dependientes. Homebrew comprueba las versiones instaladas y puede rechazar la eliminación."
          }
        }
      }
    },
    "Installed Formula Dependents" : {
      "extractionState": "manual",
      "localizations": {
