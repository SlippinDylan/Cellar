    "Use Refresh to retry reading this scope.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Refresh to retry reading this scope."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"刷新以重新读取此范围。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新整理以再次讀取此範圍。"}}}},
    "No Installed Software": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No Installed Software"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有已安装软件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"沒有已安裝軟體"}}}},
    "This scope has no installed items. Choose another scope or use Refresh.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This scope has no installed items. Choose another scope or use Refresh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此范围没有已安装项目。请选择其他范围，或刷新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此範圍沒有已安裝項目。請選擇其他範圍，或重新整理。"}}}},
