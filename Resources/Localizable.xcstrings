    "These details describe the environment used by Cellar. Open terminals may use a different environment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These details describe the environment used by Cellar. Open terminals may use a different environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下信息描述 Cellar 使用的环境，已打开的终端可能使用不同的环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下資訊描述 Cellar 使用的環境，已開啟的終端機可能使用不同的環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは Cellar が使用する環境の詳細です。開いているターミナルでは別の環境を使用している場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세부사항은 Cellar가 사용하는 환경을 설명합니다. 열린 터미널은 다른 환경을 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben beschreiben die von Cellar verwendete Umgebung. Geöffnete Terminals können eine andere Umgebung verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces détails décrivent l’environnement utilisé par Cellar. Les terminaux ouverts peuvent utiliser un environnement différent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos detalles describen el entorno que usa Cellar. Los terminales abiertos pueden usar un entorno diferente."
          }
        }
      }
    },
    "Use a separate Registry for packages in a specific organization or namespace.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a separate Registry for packages in a specific organization or namespace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为指定组织或命名空间的软件包设置专用来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅為指定組織或命名空間的套件設定專用來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の組織や名前空間のパッケージに、別のレジストリを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 조직 또는 네임스페이스의 패키지에는 별도의 레지스트리를 사용하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine separate Registry für Pakete einer bestimmten Organisation oder eines bestimmten Namensraums."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un registre distinct pour les paquets d’une organisation ou d’un espace de noms précis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un registro independiente para los paquetes de una organización o un espacio de nombres específico."
          }
        }
      }
    },
