    "Diagnostics may contain sensitive information. Review before sharing; redaction cannot recognize every secret." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostics may contain sensitive information. Review before sharing; redaction cannot recognize every secret."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断可能包含敏感信息。分享前请检查；自动隐藏无法识别所有秘密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "診斷可能包含敏感資訊。分享前請檢查；自動遮蔽無法識別所有秘密。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報に機密情報が含まれる場合があります。共有前に内容を確認してください。すべての秘密情報を自動的に伏せられるとは限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 정보에 민감한 정보가 포함될 수 있습니다. 모든 비밀 정보를 자동으로 식별할 수는 없으므로 공유 전에 검토하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedaten können vertrauliche Informationen enthalten. Prüfe sie vor dem Teilen; die Schwärzung erkennt nicht jedes Geheimnis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics peuvent contenir des informations sensibles. Vérifiez-les avant de les partager ; le masquage ne peut pas reconnaître tous les secrets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los diagnósticos pueden contener información confidencial. Revísalos antes de compartirlos; la ocultación no puede reconocer todos los secretos."
          }
        }
      }
    },
