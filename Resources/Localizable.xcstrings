    "Back up .zshrc, update its managed plugin and theme sections, and check syntax. The login shell stays unchanged." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up .zshrc, update its managed plugin and theme sections, and check syntax. The login shell stays unchanged."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份 .zshrc，更新其中受管理的插件和主题区段，并检查语法。登录 Shell 保持不变。"
