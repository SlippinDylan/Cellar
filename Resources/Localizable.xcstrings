    "Updates run one item at a time. A failure does not stop other items. Completed updates cannot be rolled back." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates run one item at a time. A failure does not stop other items. Completed updates cannot be rolled back."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新将逐项执行。单项失败不会停止其他项目。已完成的更新无法回滚。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新將逐項執行。單項失敗不會停止其他項目。已完成的更新無法回復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新は 1 件ずつ実行します。失敗してもほかの項目は続行します。完了した更新は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 하나씩 업데이트합니다. 실패해도 다른 항목은 계속 진행합니다. 완료된 업데이트는 되돌릴 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates verarbeiten die Einträge nacheinander. Ein Fehler stoppt die übrigen Einträge nicht. Abgeschlossene Updates können nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments sont mis à jour un par un. Un échec n’arrête pas les autres éléments. Les mises à jour terminées ne peuvent pas être annulées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones procesan un elemento a la vez. Un fallo no detiene los demás elementos. Las actualizaciones completadas no se pueden deshacer."
          }
        }
      }
    },
