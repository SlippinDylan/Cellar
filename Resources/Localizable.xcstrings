    "Change the user npm configuration for this Node environment. Higher priority project settings can still override it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the user npm configuration for this Node environment. Higher priority project settings can still override it."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改此 Node 环境的用户 npm 配置，更高优先级的项目设置仍可覆盖它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改此 Node 環境的使用者 npm 設定，更高優先順序的專案設定仍可覆寫它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Node 環境のユーザー npm 設定を変更します。優先順位の高いプロジェクト設定で上書きされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Node 환경의 사용자 npm 설정을 변경합니다. 우선순위가 높은 프로젝트 설정이 여전히 이를 재정의할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die npm-Benutzerkonfiguration für diese Node-Umgebung ändern. Projekteinstellungen mit höherer Priorität können sie weiterhin überschreiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier la configuration npm utilisateur pour cet environnement Node. Les réglages de projet de priorité supérieure peuvent toujours la remplacer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar la configuración de usuario de npm para este entorno Node. Los ajustes de proyecto de mayor prioridad pueden seguir prevaleciendo."
          }
        }
      }
    },
