    "Apply saves plugin selection and the local theme together. Each completed change is retained if a later change fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply saves plugin selection and the local theme together. Each completed change is retained if a later change fails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会一并保存插件选择和本机主题。后续修改失败时，已完成的修改仍会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用會一併儲存外掛選擇和本機主題。後續修改失敗時，已完成的修改仍會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインの選択とローカルテーマをまとめて保存します。途中で失敗しても、完了した変更は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인 선택과 로컬 테마를 함께 저장합니다. 이후 변경이 실패해도 이미 완료된 변경은 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Anwenden“ speichert die Plugin-Auswahl und das lokale Theme zusammen. Bereits abgeschlossene Änderungen bleiben erhalten, wenn eine spätere Änderung fehlschlägt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer enregistre ensemble les plugins sélectionnés et le thème local. Chaque modification terminée est conservée si une modification ultérieure échoue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar guarda juntos los complementos seleccionados y el tema local. Cada cambio completado se conserva si falla uno posterior."
          }
        }
      }
    },
