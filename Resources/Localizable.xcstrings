    "Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法请求命令行工具安装。请查看 Apple 官方指引，或刷新后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法請求命令列工具安裝。請查看 Apple 官方指南，或重新整理後再試。"}}}},
    "The official Homebrew installer release could not be verified.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official Homebrew installer release could not be verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证官方 Homebrew 安装器版本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證官方 Homebrew 安裝程式版本。"}}}},
    "The official release does not provide the required SHA-256. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official release does not provide the required SHA-256. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方版本未提供必需的 SHA-256，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"官方版本未提供必要的 SHA-256，未開啟安裝程式。"}}}},
    "The official SHA-256 is invalid. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official SHA-256 is invalid. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方 SHA-256 无效，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"官方 SHA-256 無效，未開啟安裝程式。"}}}},
    "The downloaded installer does not match the official SHA-256. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded installer does not match the official SHA-256. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的安装器与官方 SHA-256 不匹配，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載的安裝程式與官方 SHA-256 不相符，未開啟安裝程式。"}}}},
    "The Homebrew installer download failed. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Homebrew installer download failed. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 安装器下载失败，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 安裝程式下載失敗，未開啟安裝程式。"}}}},
    "The package signature could not be verified. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The package signature could not be verified. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证安装包签名，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證安裝套件簽署，未開啟安裝程式。"}}}},
    "Gatekeeper did not approve the package. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Gatekeeper did not approve the package. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Gatekeeper 未通过安装包检查，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Gatekeeper 未通過安裝套件檢查，未開啟安裝程式。"}}}},
    "macOS Installer could not be opened. Use the official Homebrew website for guidance.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"macOS Installer could not be opened. Use the official Homebrew website for guidance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开 macOS 安装器，请查看 Homebrew 官方网站的指引。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法開啟 macOS 安裝程式，請查看 Homebrew 官方網站的指南。"}}}},
    "The installer’s temporary file could not be managed. Use the official Homebrew website for guidance.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The installer’s temporary file could not be managed. Use the official Homebrew website for guidance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法管理安装器临时文件，请查看 Homebrew 官方网站的指引。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法管理安裝程式暫存檔案，請查看 Homebrew 官方網站的指南。"}}}},
    "A Homebrew installer handoff is still pending. Finish it before starting another.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A Homebrew installer handoff is still pending. Finish it before starting another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有 Homebrew 系统安装流程尚未结束，请先完成再重新开始。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已有 Homebrew 系統安裝流程尚未結束，請先完成再重新開始。"}}}},
    "Some Homebrew information could not be read.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some Homebrew information could not be read."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分 Homebrew 信息无法读取。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分 Homebrew 資訊無法讀取。"}}}},
