    "Node versions could not be loaded while offline. Connect to the internet and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Node versions could not be loaded while offline. Connect to the internet and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离线时无法获取 Node 版本，请连接互联网后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離線時無法取得 Node 版本，請連線至網際網路後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのため Node バージョンを読み込めませんでした。インターネットに接続して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태에서는 Node 버전을 불러올 수 없습니다. 인터넷에 연결한 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Node-Versionen konnten offline nicht geladen werden. Stelle eine Internetverbindung her und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les versions de Node hors ligne. Connectez-vous à Internet et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las versiones de Node sin conexión. Conéctate a internet y reintenta."
          }
        }
      }
    },
