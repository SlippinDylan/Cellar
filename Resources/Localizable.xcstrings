    "Command Line Tools Required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Line Tools Required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要命令行工具"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要命令列工具"}}}},
    "Homebrew needs Apple’s Command Line Tools. macOS handles the installation.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Homebrew needs Apple’s Command Line Tools. macOS handles the installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 需要 Apple 命令行工具，由 macOS 处理安装。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 需要 Apple 命令列工具，由 macOS 處理安裝。"}}}},
    "Install Command Line Tools…": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Install Command Line Tools…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装命令行工具…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝命令列工具…"}}}},
    "Installer Opened. Complete or cancel the installation in macOS Installer, then recheck. Opening Installer does not confirm installation.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installer Opened. Complete or cancel the installation in macOS Installer, then recheck. Opening Installer does not confirm installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已打开安装器。在 macOS 安装器中完成或取消安装后，再次检查。打开安装器不代表安装成功。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已開啟安裝程式。在 macOS 安裝程式中完成或取消安裝後，再次檢查。開啟安裝程式不代表安裝成功。"}}}},
    "Finished in Installer — Recheck": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Finished in Installer — Recheck"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已结束系统安装 — 再次检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已結束系統安裝 — 再次檢查"}}}},
    "Homebrew Not Installed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Homebrew Not Installed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未安装 Homebrew"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未安裝 Homebrew"}}}},
    "Cellar verifies the official signed package. macOS Installer handles authorization and installation.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cellar verifies the official signed package. macOS Installer handles authorization and installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Cellar 验证官方签名安装包，由 macOS 安装器处理授权与安装。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Cellar 驗證官方簽署安裝套件，由 macOS 安裝程式處理授權與安裝。"}}}},
    "Open Homebrew Installer…": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Homebrew Installer…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开 Homebrew 安装器…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟 Homebrew 安裝程式…"}}}},
    "Preparing System Installation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Preparing System Installation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在准备系统安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在準備系統安裝"}}}},
    "Installation requested. Finish in the system dialog, then refresh.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation requested. Finish in the system dialog, then refresh."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已请求安装。在系统对话框中完成后，请刷新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已請求安裝。在系統對話框中完成後，請重新整理。"}}}},
    "No updates reported by the last check.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"No updates reported by the last check."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上次检查未报告可用更新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"上次檢查未回報可用更新。"}}}},
    "And %@ More": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"And %@ More"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另有 %@ 项"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"另有 %@ 項"}}}},
    "View Updates": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"View Updates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"查看更新"}}}},
    "Local Version Unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Version Unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机版本不可用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機版本無法使用"}}}},
    "Online Version Not Checked": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Online Version Not Checked"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未检查线上版本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未檢查線上版本"}}}},
    "Checking Official Version": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking Official Version"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查官方版本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在檢查官方版本"}}}},
    "Latest: %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Latest: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"最新版本：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"最新版本：%@"}}}},
    "Online Check Unavailable — Offline": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Online Check Unavailable — Offline"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"线上检查不可用 — 离线"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"線上檢查無法使用 — 離線"}}}},
    "Online Version Check Failed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Online Version Check Failed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"线上版本检查失败"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"線上版本檢查失敗"}}}},
    "Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法请求命令行工具安装。请查看 Apple 官方指引，或刷新后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法請求命令列工具安裝。請查看 Apple 官方指南，或重新整理後再試。"}}}},
    "The official Homebrew installer release could not be verified.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official Homebrew installer release could not be verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证官方 Homebrew 安装器版本。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證官方 Homebrew 安裝程式版本。"}}}},
    "The official release does not provide the required SHA-256. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official release does not provide the required SHA-256. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方版本未提供必需的 SHA-256，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"官方版本未提供必要的 SHA-256，未開啟安裝程式。"}}}},
    "The official SHA-256 is invalid. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The official SHA-256 is invalid. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"官方 SHA-256 无效，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"官方 SHA-256 無效，未開啟安裝程式。"}}}},
    "The downloaded installer does not match the official SHA-256. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded installer does not match the official SHA-256. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的安装器与官方 SHA-256 不匹配，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載的安裝程式與官方 SHA-256 不相符，未開啟安裝程式。"}}}},
    "The Homebrew installer download failed. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The Homebrew installer download failed. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 安装器下载失败，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 安裝程式下載失敗，未開啟安裝程式。"}}}},
    "The package signature could not be verified. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The package signature could not be verified. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证安装包签名，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證安裝套件簽署，未開啟安裝程式。"}}}},
    "Gatekeeper did not approve the package. The installer was not opened.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Gatekeeper did not approve the package. The installer was not opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Gatekeeper 未通过安装包检查，未打开安装器。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Gatekeeper 未通過安裝套件檢查，未開啟安裝程式。"}}}},
    "macOS Installer could not be opened. Use the official Homebrew website for guidance.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"macOS Installer could not be opened. Use the official Homebrew website for guidance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法打开 macOS 安装器，请查看 Homebrew 官方网站的指引。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法開啟 macOS 安裝程式，請查看 Homebrew 官方網站的指南。"}}}},
    "The installer’s temporary file could not be managed. Use the official Homebrew website for guidance.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The installer’s temporary file could not be managed. Use the official Homebrew website for guidance."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法管理安装器临时文件，请查看 Homebrew 官方网站的指引。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法管理安裝程式暫存檔案，請查看 Homebrew 官方網站的指南。"}}}},
    "A Homebrew installer handoff is still pending. Finish it before starting another.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"A Homebrew installer handoff is still pending. Finish it before starting another."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已有 Homebrew 系统安装流程尚未结束，请先完成再重新开始。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已有 Homebrew 系統安裝流程尚未結束，請先完成再重新開始。"}}}},
    "Some Homebrew information could not be read.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Some Homebrew information could not be read."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分 Homebrew 信息无法读取。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"部分 Homebrew 資訊無法讀取。"}}}},
    "Local Homebrew refresh failed. Previously read information is retained.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Homebrew refresh failed. Previously read information is retained."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机 Homebrew 刷新失败，已保留先前读取的信息。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機 Homebrew 重新整理失敗，已保留先前讀取的資訊。"}}}},
    "Local Refresh": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Refresh"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机刷新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機重新整理"}}}},
    "Local Node refresh failed. Previously read information is retained.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Local Node refresh failed. Previously read information is retained."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本机 Node 刷新失败，已保留先前读取的信息。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"本機 Node 重新整理失敗，已保留先前讀取的資訊。"}}}},
    "Command Line Tools could not be checked. Refresh to try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Command Line Tools could not be checked. Refresh to try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法检查命令行工具，请刷新后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法檢查命令列工具，請重新整理後再試。"}}}},
    "Homebrew is unavailable. Refresh or use the official recovery guidance; existing files will not be replaced.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Homebrew is unavailable. Refresh or use the official recovery guidance; existing files will not be replaced."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Homebrew 不可用。请刷新或查看官方恢复指引；现有文件不会被替换。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Homebrew 無法使用。請重新整理或查看官方復原指南；現有檔案不會被取代。"}}}},
    "Updates could not be checked. Local information is still available.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Updates could not be checked. Local information is still available."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法检查更新，本机信息仍可查看。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法檢查更新，本機資訊仍可查看。"}}}},
