    "A Homebrew installer handoff is still pending. Finish it before starting another." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Homebrew installer handoff is still pending. Finish it before starting another."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 Homebrew 系统安装流程尚未结束，请先完成再重新开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有 Homebrew 系統安裝流程尚未結束，請先完成再重新開始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew インストーラへの引き渡しがまだ完了していません。完了してから次を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 설치 프로그램으로의 전달이 아직 대기 중입니다. 완료한 후 다른 작업을 시작하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übergabe an ein Homebrew-Installationsprogramm steht noch aus. Schließe sie ab, bevor du eine weitere startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un transfert vers le programme d’installation de Homebrew est toujours en attente. Terminez-le avant d’en lancer un autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue pendiente una transferencia al instalador de Homebrew. Termínala antes de iniciar otra."
          }
        }
      }
    },
