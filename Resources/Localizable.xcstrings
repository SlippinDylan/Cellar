  "Administrator cleanup did not finish. Check authorization and file permissions.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Administrator cleanup did not finish. Check authorization and file permissions."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "管理员清理未完成。请检查授权和文件权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "管理員清理未完成。請檢查授權和檔案權限。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "管理者権限でのクリーンアップが完了しませんでした。認証とファイルのアクセス権を確認してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "관리자 권한 정리가 완료되지 않았습니다. 인증과 파일 권한을 확인하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Bereinigung mit Administratorrechten wurde nicht abgeschlossen. Prüfe die Autorisierung und Dateiberechtigungen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le nettoyage avec autorisation administrateur n’a pas abouti. Vérifiez l’autorisation et les permissions des fichiers."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "La limpieza con autorización de administrador no terminó. Comprueba la autorización y los permisos de los archivos."
        }
      }
    }
  },
  "The application is still running. Quit it before continuing.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The application is still running. Quit it before continuing."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "应用仍在运行。请先退出应用，再继续处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "應用程式仍在執行。請先結束應用程式，再繼續處理。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アプリケーションがまだ実行中です。終了してから続けてください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "앱이 아직 실행 중입니다. 종료한 후 계속하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Anwendung läuft noch. Beende sie, bevor du fortfährst."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’application est toujours en cours d’exécution. Quittez-la avant de continuer."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "La aplicación sigue ejecutándose. Ciérrala antes de continuar."
        }
      }
    }
  },
  "Homebrew removed the package. Quit its remaining processes, then handle this path manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Quit its remaining processes, then handle this path manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请先退出其仍在运行的进程，再到访达手动处理此路径。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請先結束其仍在執行的程序，再到 Finder 手動處理此路徑。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew はパッケージを削除しました。残っているプロセスを終了し、このパスを Finder で手動で処理してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew가 패키지를 제거했습니다. 남아 있는 프로세스를 종료한 다음 Finder에서 이 경로를 직접 처리하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew hat das Paket entfernt. Beende die verbleibenden Prozesse und bearbeite diesen Pfad anschließend manuell im Finder."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew a supprimé le paquet. Quittez ses processus restants, puis traitez ce chemin manuellement dans le Finder."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew eliminó el paquete. Cierra sus procesos restantes y después gestiona esta ruta manualmente en Finder."
        }
      }
    }
  },
  "Homebrew removed the package. Check authorization and file permissions, then handle this path manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Check authorization and file permissions, then handle this path manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请检查授权和文件权限，再到访达手动处理此路径。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請檢查授權和檔案權限，再到 Finder 手動處理此路徑。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew はパッケージを削除しました。認証とファイルのアクセス権を確認し、このパスを Finder で手動で処理してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew가 패키지를 제거했습니다. 인증과 파일 권한을 확인한 다음 Finder에서 이 경로를 직접 처리하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew hat das Paket entfernt. Prüfe die Autorisierung und Dateiberechtigungen und bearbeite diesen Pfad anschließend manuell im Finder."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew a supprimé le paquet. Vérifiez l’autorisation et les permissions des fichiers, puis traitez ce chemin manuellement dans le Finder."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew eliminó el paquete. Comprueba la autorización y los permisos de los archivos y después gestiona esta ruta manualmente en Finder."
        }
      }
    }
  },
  "Homebrew removed the package. Confirm this path’s ownership and current state before handling it manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package. Confirm this path’s ownership and current state before handling it manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包。请先确认此路径的归属和当前状态，再到访达手动处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件。請先確認此路徑的歸屬和目前狀態，再到 Finder 手動處理。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew はパッケージを削除しました。このパスの帰属と現在の状態を確認してから、Finder で手動で処理してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew가 패키지를 제거했습니다. Finder에서 직접 처리하기 전에 이 경로의 소유 관계와 현재 상태를 확인하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew hat das Paket entfernt. Prüfe die Zugehörigkeit und den aktuellen Zustand dieses Pfads, bevor du ihn manuell im Finder bearbeitest."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew a supprimé le paquet. Vérifiez à qui appartient ce chemin et son état actuel avant de le traiter manuellement dans le Finder."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew eliminó el paquete. Confirma a qué pertenece esta ruta y su estado actual antes de gestionarla manualmente en Finder."
        }
      }
    }
  },
  "Homebrew removed the package, but this path remains. Review it before handling it manually in Finder.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew removed the package, but this path remains. Review it before handling it manually in Finder."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此软件包，但此路径仍然存在。请先检查，再到访达手动处理。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew 已移除此套件，但此路徑仍然存在。請先檢查，再到 Finder 手動處理。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew はパッケージを削除しましたが、このパスは残っています。内容を確認してから、Finder で手動で処理してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew가 패키지를 제거했지만 이 경로는 남아 있습니다. Finder에서 직접 처리하기 전에 확인하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew hat das Paket entfernt, aber dieser Pfad ist noch vorhanden. Prüfe ihn, bevor du ihn manuell im Finder bearbeitest."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew a supprimé le paquet, mais ce chemin subsiste. Examinez-le avant de le traiter manuellement dans le Finder."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Homebrew eliminó el paquete, pero esta ruta sigue existiendo. Revísala antes de gestionarla manualmente en Finder."
        }
      }
    }
  },

  "This data may be shared or its ownership is unclear. Check the impact before removing it manually.": {
  "localizations": {
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "This data may be shared or its ownership is unclear. Check the impact before removing it manually."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "此数据可能共享，或无法确认归属。手动移除前请先确认影响。"
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "此資料可能共用，或無法確認歸屬。手動移除前請先確認影響。"
      }
    },
    "ja": {
      "stringUnit": {
        "state": "translated",
        "value": "このデータは共有されているか、帰属が不明です。影響を確認してから手動で削除してください。"
      }
    },
    "ko": {
      "stringUnit": {
        "state": "translated",
        "value": "이 데이터는 공유되거나 소유 관계가 불분명할 수 있습니다. 직접 제거하기 전에 영향을 확인하세요."
      }
    },
    "de": {
      "stringUnit": {
        "state": "translated",
        "value": "Diese Daten werden möglicherweise gemeinsam genutzt oder ihre Zugehörigkeit ist unklar. Prüfe die Auswirkungen, bevor du sie manuell entfernst."
      }
    },
    "fr": {
      "stringUnit": {
        "state": "translated",
        "value": "Ces données peuvent être partagées ou leur appartenance est incertaine. Vérifiez les conséquences avant de les supprimer manuellement."
      }
    },
    "es": {
      "stringUnit": {
        "state": "translated",
        "value": "Estos datos pueden ser compartidos o su pertenencia no está clara. Comprueba las consecuencias antes de eliminarlos manualmente."
      }
    }
  }
},
  "File ownership could not be fully verified. These files were kept.": {
  "localizations": {
    "en": {
      "stringUnit": {
        "state": "translated",
        "value": "File ownership could not be fully verified. These files were kept."
      }
    },
    "zh-Hans": {
      "stringUnit": {
        "state": "translated",
        "value": "未能完整验证文件归属，已保留这些文件。"
      }
    },
    "zh-Hant": {
      "stringUnit": {
        "state": "translated",
        "value": "未能完整驗證檔案歸屬，已保留這些檔案。"
      }
    },
    "ja": {
      "stringUnit": {
        "state": "translated",
        "value": "ファイルの帰属を完全には確認できませんでした。これらのファイルは残しました。"
      }
    },
    "ko": {
      "stringUnit": {
        "state": "translated",
        "value": "파일의 소유 관계를 완전히 확인할 수 없어 해당 파일을 유지했습니다."
      }
    },
    "de": {
      "stringUnit": {
        "state": "translated",
        "value": "Die Zugehörigkeit der Dateien konnte nicht vollständig überprüft werden. Diese Dateien wurden beibehalten."
      }
    },
    "fr": {
      "stringUnit": {
        "state": "translated",
        "value": "L’appartenance des fichiers n’a pas pu être entièrement vérifiée. Ces fichiers ont été conservés."
      }
    },
    "es": {
      "stringUnit": {
        "state": "translated",
        "value": "No se pudo verificar por completo a qué pertenecen los archivos. Se conservaron estos archivos."
      }
    }
  }
},
  "The application is still running. Quit it, then review the uninstallation again.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The application is still running. Quit it, then review the uninstallation again."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "应用仍在运行，请先退出应用，再重新检查卸载清单。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "App 仍在執行，請先結束 App，再重新檢查解除安裝清單。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アプリケーションがまだ実行中です。終了してから、アンインストールの内容を再確認してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "앱이 아직 실행 중입니다. 종료한 다음 제거 내용을 다시 검토하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Anwendung läuft noch. Beende sie und prüfe die Deinstallation erneut."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’application est toujours en cours d’exécution. Quittez-la, puis examinez de nouveau la désinstallation."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "La aplicación sigue ejecutándose. Ciérrala y vuelve a revisar la desinstalación."
        }
      }
    }
  },
  "Inspect protected application data during uninstallation.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Inspect protected application data during uninstallation."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "用于卸载时分析受保护的应用数据。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "用於解除安裝時分析受保護的 App 資料。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アンインストール時に、保護されたアプリケーションデータを調べます。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "앱 제거 중 보호된 앱 데이터를 검사합니다."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Geschützte Anwendungsdaten bei der Deinstallation prüfen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Examiner les données protégées de l’application lors de la désinstallation."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Inspeccionar los datos protegidos de la aplicación durante la desinstalación."
        }
      }
    }
  },
  "Access is blocked. Check Full Disk Access in System Settings.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Access is blocked. Check Full Disk Access in System Settings."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "访问受限，请在系统设置中检查完全磁盘访问权限。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "存取受限，請在系統設定中檢查完整磁碟存取權限。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "アクセスが拒否されました。システム設定でフルディスクアクセスを確認してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "접근이 차단되었습니다. 시스템 설정에서 전체 디스크 접근 권한을 확인하세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der Zugriff ist blockiert. Prüfe den Festplattenvollzugriff in den Systemeinstellungen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L’accès est bloqué. Vérifiez l’accès complet au disque dans Réglages Système."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "El acceso está bloqueado. Comprueba el acceso total al disco en Ajustes del Sistema."
        }
      }
    }
  },

  "Drag Cellar into the Full Disk Access list in System Settings, then turn on its switch.": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Drag Cellar into the Full Disk Access list in System Settings, then turn on its switch."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "将 Cellar 拖入系统设置的“完全磁盘访问权限”列表，再打开开关。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "將 Cellar 拖入系統設定的「完整磁碟存取權限」列表，再開啟開關。"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "システム設定のフルディスクアクセスの一覧に Cellar をドラッグし、スイッチをオンにしてください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "시스템 설정의 전체 디스크 접근 권한 목록으로 Cellar를 드래그한 다음 스위치를 켜세요."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Ziehe Cellar in die Liste für den Festplattenvollzugriff in den Systemeinstellungen und aktiviere den zugehörigen Schalter."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Faites glisser Cellar dans la liste Accès complet au disque de Réglages Système, puis activez son interrupteur."
        }
      },
      "es": {
        "stringUnit": {
          "state": "translated",
          "value": "Arrastra Cellar a la lista de acceso total al disco en Ajustes del Sistema y activa su interruptor."
        }
      }
    }
  },
