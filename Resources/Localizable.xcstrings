    "Local Homebrew refresh failed. Previously read information is retained." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local Homebrew refresh failed. Previously read information is retained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本机 Homebrew 刷新失败，已保留先前读取的信息。"
