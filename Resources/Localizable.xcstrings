    "Current or default Node versions and protected packages cannot be removed. Choose another target." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current or default Node versions and protected packages cannot be removed. Choose another target."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除当前或默认 Node 版本及受保护的软件包。请选择其他目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法移除目前或預設 Node 版本及受保護的套件。請選擇其他目標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中または既定の Node バージョンと保護されたパッケージは削除できません。別の対象を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 또는 기본 Node 버전과 보호된 패키지는 제거할 수 없습니다. 다른 대상을 선택하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle oder standardmäßig verwendete Node-Versionen und geschützte Pakete können nicht entfernt werden. Wähle ein anderes Ziel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions Node actuelles ou par défaut et les paquets protégés ne peuvent pas être supprimés. Choisissez une autre cible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden eliminar las versiones de Node actuales o predeterminadas ni los paquetes protegidos. Elige otro objetivo."
          }
        }
      }
    },
