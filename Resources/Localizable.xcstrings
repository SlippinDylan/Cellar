    "Check this source, then press Return to retry. Installed software remains available in Library." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check this source, then press Return to retry. Installed software remains available in Library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查此来源，然后按回车键重试。已安装软件仍可在软件库中查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檢查此來源，然後按 Return 鍵再試一次。已安裝軟體仍可在資料庫中查看。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取得元を確認し、Return キーで再試行してください。インストール済みソフトウェアは引き続きライブラリで利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스를 확인한 다음 Return을 눌러 다시 시도하세요. 설치된 소프트웨어는 소프트웨어 보관함에서 계속 사용할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe diese Quelle und drücke die Eingabetaste, um es erneut zu versuchen. Installierte Software bleibt in der Mediathek verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez cette source, puis appuyez sur Retour pour réessayer. Les logiciels installés restent disponibles dans la bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba esta fuente y pulsa Retorno para reintentar. El software instalado sigue disponible en la biblioteca."
          }
        }
      }
    },
