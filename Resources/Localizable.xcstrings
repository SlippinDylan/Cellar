    "Homebrew is unavailable. Refresh or use the official recovery guidance; existing files will not be replaced." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew is unavailable. Refresh or use the official recovery guidance; existing files will not be replaced."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 不可用。请刷新或查看官方恢复指引；现有文件不会被替换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebrew 無法使用。請重新整理或查看官方復原指南；現有檔案不會被取代。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew を利用できません。再読み込みするか、公式の復旧手順を参照してください。既存のファイルは置き換えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew를 사용할 수 없습니다. 새로 고치거나 공식 복구 안내를 이용하세요. 기존 파일은 대체되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ist nicht verfügbar. Lade die Ansicht neu oder verwende die offizielle Wiederherstellungsanleitung; vorhandene Dateien werden nicht ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew est indisponible. Actualisez ou consultez les instructions officielles de récupération ; les fichiers existants ne seront pas remplacés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no está disponible. Actualiza la información o consulta las instrucciones oficiales de recuperación; no se reemplazarán los archivos existentes."
          }
        }
      }
    },
