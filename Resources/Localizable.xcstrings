    "Installation could not start. Refresh and check the selected packages, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation could not start. Refresh and check the selected packages, then try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法开始安装。请刷新并检查所选软件包，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開始安裝。請重新整理並檢查所選套件，然後再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールを開始できませんでした。再読み込みし、選択したパッケージを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치를 시작할 수 없습니다. 새로 고침 후 선택한 패키지를 확인하고 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation konnte nicht gestartet werden. Lade die Ansicht neu, prüfe die ausgewählten Pakete und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lancer l’installation. Actualisez et vérifiez les paquets sélectionnés, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la instalación. Actualiza la información, comprueba los paquetes seleccionados y reintenta."
          }
        }
      }
    },
    "Installation finished, but the environment could not be refreshed. Use Refresh to check the current state." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation finished, but the environment could not be refreshed. Use Refresh to check the current state."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装已结束，但无法刷新环境。请刷新以检查当前状态。"
