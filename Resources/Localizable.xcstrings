    "%@: Update Check Failed. Known versions are retained. Use Refresh or check again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Update Check Failed. Known versions are retained. Use Refresh or check again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：更新检查失败，已保留已知版本。请刷新或重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：更新檢查失敗，已保留已知版本。請重新整理或再次檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 更新の確認に失敗しました。取得済みのバージョンは保持しています。再読み込みするか、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: 업데이트 확인 실패. 확인된 버전 정보는 유지됩니다. 새로 고치거나 다시 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Updateprüfung fehlgeschlagen. Bekannte Versionen bleiben erhalten. Lade die Ansicht neu oder prüfe erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : échec de la recherche de mises à jour. Les versions connues sont conservées. Actualisez ou relancez la recherche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: error al buscar actualizaciones. Se conservan las versiones conocidas. Actualiza la información o vuelve a comprobarlo."
          }
        }
      }
    },
