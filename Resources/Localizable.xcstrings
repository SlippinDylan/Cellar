    "Session changes affect Cellar only. Setting the default affects future nvm sessions." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session changes affect Cellar only. Setting the default affects future nvm sessions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话切换仅影响 Cellar。设置默认版本会影响之后的 nvm 会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段切換僅影響 Cellar。設定預設版本會影響之後的 nvm 工作階段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの変更は Cellar にのみ適用されます。既定の設定は、今後の nvm セッションに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 변경은 Cellar에만 적용됩니다. 기본값 설정은 향후 nvm 세션에 적용됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzungsänderungen betreffen nur Cellar. Das Festlegen des Standards betrifft zukünftige nvm-Sitzungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de session ne concernent que Cellar. Définir la version par défaut affecte les futures sessions nvm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de sesión solo afectan a Cellar. Establecer el valor predeterminado afecta a futuras sesiones de nvm."
          }
        }
      }
    },
