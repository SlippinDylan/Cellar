    "Local Terminal refresh failed. Previously read information is retained.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Terminal refresh failed. Previously read information is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机终端刷新失败，已保留先前读取的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機終端重新整理失敗，已保留先前讀取的資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのターミナル環境を再読み込みできませんでした。取得済みの情報は保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 터미널 새로 고침에 실패했습니다. 이전에 읽은 정보는 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Neuladen der lokalen Terminaldaten ist fehlgeschlagen. Zuvor eingelesene Informationen bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’actualisation locale du terminal. Les informations déjà lues sont conservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar la información local del terminal. Se conserva la información leída anteriormente."
          }
        }
      }
    },
