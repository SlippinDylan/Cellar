    "Cancel Search": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cancel Search"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消搜索"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消搜尋"}}}},
    "Find Software": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Find Software"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找软件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尋找軟體"}}}},
    "Choose a scope, enter a name, then press Return or Search.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose a scope, enter a name, then press Return or Search."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择范围并输入名称，然后按回车键或点按“搜索”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選擇範圍並輸入名稱，然後按 Return 鍵或按一下「搜尋」。"}}}},
    "Search Unavailable": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search Unavailable"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索不可用"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋無法使用"}}}},
    "Check this source and try Search again. Installed software remains available in Library.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Check this source and try Search again. Installed software remains available in Library."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查此来源后再次搜索。已安装软件仍可在软件库中查看。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查此來源後再次搜尋。已安裝軟體仍可在資料庫中查看。"}}}},
    "Search Cancelled": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search Cancelled"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索已取消"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋已取消"}}}},
    "Press Search to try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Press Search to try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"点按“搜索”以重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"按一下「搜尋」以再試一次。"}}}},
    "Another Task Is Running": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Another Task Is Running"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"另一个任务正在运行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"另一個作業正在執行"}}}},
    "Wait for the current task to finish, then press Search.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Wait for the current task to finish, then press Search."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"等待当前任务完成，然后点按“搜索”。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"等待目前作業完成，然後按一下「搜尋」。"}}}},
    "Homebrew Required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Homebrew Required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要 Homebrew"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要 Homebrew"}}}},
    "Use Home to set up Homebrew, or Refresh to check the local environment.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Home to set up Homebrew, or Refresh to check the local environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在首页设置 Homebrew，或刷新以检查本机环境。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在首頁設定 Homebrew，或重新整理以檢查本機環境。"}}}},
    "Node and npm Required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Node and npm Required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要 Node 和 npm"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要 Node 和 npm"}}}},
    "Use Home to check Node and npm. Search needs a known Node environment.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Home to check Node and npm. Search needs a known Node environment."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在首页检查 Node 和 npm。搜索需要明确的 Node 环境。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"在首頁檢查 Node 和 npm。搜尋需要明確的 Node 環境。"}}}},
    "Registry Required": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Registry Required"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要 Registry"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要 Registry"}}}},
    "The effective npm Registry is unavailable. Check Sources and Refresh before searching.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The effective npm Registry is unavailable. Check Sources and Refresh before searching."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取有效的 npm Registry。搜索前请检查来源设置并刷新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法讀取有效的 npm Registry。搜尋前請檢查來源設定並重新整理。"}}}},
    "Go to Home": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Go to Home"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前往首页"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前往首頁"}}}},
    "Registry: %@": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Registry: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Registry：%@"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"Registry：%@"}}}},
    "Install Software": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Install Software"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装软件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝軟體"}}}},
    "%@ Items to Install": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ Items to Install"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将安装 %@ 项"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將安裝 %@ 項"}}}},
    "Installation runs one item at a time. A failure does not stop other items. Completed installations cannot be rolled back.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation runs one item at a time. A failure does not stop other items. Completed installations cannot be rolled back."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装将逐项执行。单项失败不会停止其他项目。已完成的安装无法回滚。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝將逐項執行。單項失敗不會停止其他項目。已完成的安裝無法回復。"}}}},
    "Back": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Back"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"返回"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"返回"}}}},
    "Install Scope": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Install Scope"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装范围"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝範圍"}}}},
    "Enter one package per line. Blank lines and duplicate entries are removed. Maximum 100 items from one scope.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter one package per line. Blank lines and duplicate entries are removed. Maximum 100 items from one scope."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每行输入一个软件包。空行和重复项会被移除。一次最多安装同一范围的 100 项。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每行輸入一個套件。空行和重複項目會被移除。一次最多安裝同一範圍的 100 項。"}}}},
    "Packages to Install": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Packages to Install"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"要安装的软件包"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"要安裝的套件"}}}},
    "Review Installation": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Installation"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查安装内容"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查安裝內容"}}}},
    "Installation Results": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation Results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装结果"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝結果"}}}},
    "Installation finished, but the environment could not be refreshed. Use Refresh to check the current state.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation finished, but the environment could not be refreshed. Use Refresh to check the current state."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装已结束，但无法刷新环境。请刷新以检查当前状态。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝已結束，但無法重新整理環境。請重新整理以檢查目前狀態。"}}}},
    "Installed": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝"}}}},
    "Enter at least one package.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter at least one package."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请至少输入一个软件包。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請至少輸入一個套件。"}}}},
    "Use up to 100 packages in one installation.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use up to 100 packages in one installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"一次最多安装 100 个软件包。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"一次最多安裝 100 個套件。"}}}},
    "Use package names from the selected scope. npm also accepts a version or tag. URLs, local paths and mixed scopes are not supported.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Use package names from the selected scope. npm also accepts a version or tag. URLs, local paths and mixed scopes are not supported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请使用所选范围的软件包名称。npm 也支持版本或标签。不支持 URL、本地路径或混合范围。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"請使用所選範圍的套件名稱。npm 也支援版本或標籤。不支援 URL、本機路徑或混合範圍。"}}}},
    "Refresh and check Homebrew, or the target Node environment and Registry, before installing.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Refresh and check Homebrew, or the target Node environment and Registry, before installing."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"安装前请刷新并检查 Homebrew，或目标 Node 环境及 Registry。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"安裝前請重新整理並檢查 Homebrew，或目標 Node 環境及 Registry。"}}}},
    "The target environment or Registry changed. Review the installation again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The target environment or Registry changed. Review the installation again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标环境或 Registry 已变化。请重新检查安装内容。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目標環境或 Registry 已變更。請重新檢查安裝內容。"}}}},
    "Installation could not start. Refresh and check the selected packages, then try again.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Installation could not start. Refresh and check the selected packages, then try again."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法开始安装。请刷新并检查所选软件包，然后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法開始安裝。請重新整理並檢查所選套件，然後再試一次。"}}}},
    "Remaining npm Files": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Remaining npm Files"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"npm 残留文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"npm 殘留檔案"}}}},
    "The package was removed. These paths remain.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"The package was removed. These paths remain."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"软件包已移除，以下路径仍然保留。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"套件已移除，以下路徑仍然保留。"}}}},
    "Finish Managing Library": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Finish Managing Library"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结束资料库管理"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結束資料庫管理"}}}},
