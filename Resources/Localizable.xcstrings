    "Already Installed · Will Not Install": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Already Installed · Will Not Install"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装 · 不会重复安装"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已安裝 · 不會重複安裝"}}}},
