    "Search returns up to 50 results.": {"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Search returns up to 50 results."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"搜索最多返回 50 项结果。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"搜尋最多傳回 50 項結果。"}}}},
