    "Cellar verifies the official signed package. macOS Installer handles authorization and installation." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar verifies the official signed package. macOS Installer handles authorization and installation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 验证官方签名安装包，由 macOS 安装器处理授权与安装。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 驗證官方簽署安裝套件，由 macOS 安裝程式處理授權與安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar が公式の署名付きパッケージを検証します。認証とインストールは macOS のインストーラが行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar가 공식 서명된 패키지를 검증합니다. 인증과 설치는 macOS 설치 프로그램에서 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar überprüft das offizielle signierte Paket. Das macOS-Installationsprogramm übernimmt die Autorisierung und Installation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar vérifie le paquet officiel signé. Le programme d’installation de macOS gère l’autorisation et l’installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar verifica el paquete oficial firmado. El Instalador de macOS gestiona la autorización y la instalación."
          }
        }
      }
    },
    "Cellar will quit and reopen using the selected language." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar will quit and reopen using the selected language."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 将退出并以所选语言重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cellar 將結束並以所選語言重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cellar を終了し、選択した言語で再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
