    "Command Line Tools are missing or could not be verified. The Homebrew installer was not opened." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Line Tools are missing or could not be verified. The Homebrew installer was not opened."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令行工具缺失或无法验证，未打开 Homebrew 安装器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令列工具缺少或無法驗證，未開啟 Homebrew 安裝程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools がないか、確認できませんでした。Homebrew インストーラは開いていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools가 없거나 확인할 수 없습니다. Homebrew 설치 프로그램을 열지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools fehlen oder konnten nicht überprüft werden. Das Homebrew-Installationsprogramm wurde nicht geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Command Line Tools sont absents ou n’ont pas pu être vérifiés. Le programme d’installation de Homebrew n’a pas été ouvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan las Command Line Tools o no se pudieron verificar. No se abrió el instalador de Homebrew."
          }
        }
      }
    },
    "Command Line Tools could not be checked. Refresh to try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Line Tools could not be checked. Refresh to try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法检查命令行工具，请刷新后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法檢查命令列工具，請重新整理後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools を確認できませんでした。再読み込みして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools를 확인할 수 없습니다. 새로 고침하여 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools konnten nicht geprüft werden. Lade die Ansicht neu, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier les Command Line Tools. Actualisez pour réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron comprobar las Command Line Tools. Actualiza la información para reintentar."
          }
        }
      }
    },
    "Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Line Tools installation could not be requested. Use Apple’s official guide or refresh and try again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法请求命令行工具安装。请查看 Apple 官方指引，或刷新后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法請求命令列工具安裝。請查看 Apple 官方指南，或重新整理後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools のインストールを要求できませんでした。Apple の公式ガイドを参照するか、再読み込みして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Line Tools 설치를 요청할 수 없습니다. Apple 공식 안내를 이용하거나 새로 고침 후 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation der Command Line Tools konnte nicht angefordert werden. Verwende die offizielle Anleitung von Apple oder lade die Ansicht neu und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l’installation des Command Line Tools. Consultez le guide officiel d’Apple ou actualisez et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo solicitar la instalación de Command Line Tools. Consulta la guía oficial de Apple o actualiza la información y reintenta."
          }
        }
      }
    },
