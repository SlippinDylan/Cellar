          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールは完了しましたが、環境を再読み込みできませんでした。再読み込みして現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치는 완료되었지만 환경을 새로 고칠 수 없습니다. 새로 고침으로 현재 상태를 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation wurde abgeschlossen, aber die Umgebung konnte nicht neu geladen werden. Lade die Ansicht neu, um den aktuellen Zustand zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation est terminée, mais l’environnement n’a pas pu être actualisé. Actualisez pour vérifier son état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación terminó, pero no se pudo actualizar la información del entorno. Actualiza la información para comprobar su estado actual."
          }
        }
      }
    },
    "Installation requested. Finish in the system dialog, then refresh." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installation requested. Finish in the system dialog, then refresh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已请求安装。在系统对话框中完成后，请刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已請求安裝。在系統對話框中完成後，請重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールを要求しました。システムのダイアログで完了してから、再読み込みしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치를 요청했습니다. 시스템 대화상자에서 완료한 다음 새로 고치세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation angefordert. Schließe sie im Systemdialog ab und lade anschließend die Ansicht neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation demandée. Terminez dans la boîte de dialogue système, puis actualisez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalación solicitada. Termínala en el diálogo del sistema y actualiza la información."
          }
        }
      }
    },
