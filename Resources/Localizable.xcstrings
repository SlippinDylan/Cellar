    "Other installed applications may share this data. Shared files will be kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other installed applications may share this data. Shared files will be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已安装的应用可能共用这些数据，共享文件将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已安裝的應用程式可能共用這些資料，共享檔案將被保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのインストール済みアプリケーションも、このデータを共有している場合があります。共有ファイルは残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 다른 앱이 이 데이터를 공유할 수 있습니다. 공유 파일은 유지됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere installierte Anwendungen nutzen diese Daten möglicherweise ebenfalls. Gemeinsam genutzte Dateien werden beibehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres applications installées peuvent partager ces données. Les fichiers partagés seront conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras aplicaciones instaladas pueden compartir estos datos. Se conservarán los archivos compartidos."
          }
        }
      }
    },
    "Some locations could not be fully inspected. Additional files may remain.": {
      "localizations": {
        "en": {
