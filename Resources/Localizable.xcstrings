    "Saved history could not be isolated safely. Recording is paused. Check storage access and retry loading history." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved history could not be isolated safely. Recording is paused. Check storage access and retry loading history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法安全隔离已保存的历史，记录已暂停。请检查存储访问权限并重试读取历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法安全隔離已儲存的歷史，記錄已暫停。請檢查儲存空間的存取權限並重試讀取歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み履歴を安全に隔離できませんでした。記録を一時停止しています。ストレージへのアクセスを確認し、履歴の読み込みを再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 안전하게 격리할 수 없습니다. 기록을 일시 중지했습니다. 저장소 접근을 확인한 다음 기록 불러오기를 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Verlauf konnte nicht sicher isoliert werden. Die Aufzeichnung ist pausiert. Prüfe den Speicherzugriff und lade den Verlauf erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’isoler l’historique enregistré en toute sécurité. L’enregistrement est suspendu. Vérifiez l’accès au stockage et réessayez de charger l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aislar de forma segura el historial guardado. El registro está en pausa. Comprueba el acceso al almacenamiento y reintenta cargar el historial."
          }
        }
      }
    },
    "Saved history could not be read and was isolated. New tasks can still be recorded." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved history could not be read and was isolated. New tasks can still be recorded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取已保存的历史，已将其隔离。新任务仍可记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取已儲存的歷史，已將其隔離。新任務仍可記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み履歴を読み込めなかったため隔離しました。新しいタスクは引き続き記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 읽을 수 없어 격리했습니다. 새 작업은 계속 기록할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Verlauf konnte nicht gelesen werden und wurde isoliert. Neue Aufgaben können weiterhin aufgezeichnet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique enregistré n’a pas pu être lu et a été isolé. Les nouvelles tâches peuvent toujours être enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el historial guardado y se ha aislado. Se pueden seguir registrando tareas nuevas."
          }
        }
      }
    },
    "Saved history is unavailable. Check storage access and retry loading history." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved history is unavailable. Check storage access and retry loading history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的历史不可用。请检查存储访问权限并重试读取历史。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的歷史無法使用。請檢查儲存空間的存取權限並重試讀取歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み履歴を利用できません。ストレージへのアクセスを確認し、履歴の読み込みを再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록을 사용할 수 없습니다. 저장소 접근을 확인한 다음 기록 불러오기를 다시 시도하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Verlauf ist nicht verfügbar. Prüfe den Speicherzugriff und lade den Verlauf erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique enregistré est indisponible. Vérifiez l’accès au stockage et réessayez de charger l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial guardado no está disponible. Comprueba el acceso al almacenamiento y reintenta cargar el historial."
          }
        }
      }
    },
