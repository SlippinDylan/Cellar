    "支持 Formula 和 Cask；空查询不请求远程目录。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports Formula and Cask. Empty queries do not request the remote catalog."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Formula 和 Cask；空查询不请求远程目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 Formula 和 Cask；空白查詢不請求遠端目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Formula と Cask に対応しています。空の検索条件ではリモートカタログを要求しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Formula와 Cask를 지원합니다. 빈 검색어로는 원격 카탈로그를 요청하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt Formula und Cask. Leere Suchanfragen rufen den entfernten Katalog nicht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend en charge Formula et Cask. Les requêtes vides n’interrogent pas le catalogue distant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admite Formula y Cask. Las consultas vacías no solicitan el catálogo remoto."
          }
        }
      }
    },
