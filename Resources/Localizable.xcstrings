    "Apply saves plugin selection and the local theme together. Each completed change is retained if a later change fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apply saves plugin selection and the local theme together. Each completed change is retained if a later change fails."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用会一并保存插件选择和本机主题。后续修改失败时，已完成的修改仍会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用會一併儲存外掛選擇和本機主題。後續修改失敗時，已完成的修改仍會保留。"
          }
        }
      }
    },
