    "Technical output is kept only for this App session and is not written to log files." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical output is kept only for this App session and is not written to log files."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术输出仅保留在当前 App 会话中，不写入日志文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
