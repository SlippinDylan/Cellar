  "Removal failed. Check access and review the item before retrying." : {
    "localizations" : {
      "en" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "Removal failed. Check access and review the item before retrying."
        }
      },
      "zh-Hans" : {
        "stringUnit" : {
          "state" : "translated",
          "value" : "移除失败，请检查访问权限和项目后再试。"
