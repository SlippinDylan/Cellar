    "Enter one package per line. Blank lines and duplicate entries are removed. Maximum 100 items from one scope." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter one package per line. Blank lines and duplicate entries are removed. Maximum 100 items from one scope."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行输入一个软件包。空行和重复项会被移除。一次最多安装同一范围的 100 项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行輸入一個套件。空行和重複項目會被移除。一次最多安裝同一範圍的 100 項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 パッケージを入力してください。空行と重複項目は除去されます。同じ範囲から最大 100 件まで指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 패키지 하나를 입력하세요. 빈 줄과 중복 항목은 제거됩니다. 한 범위에서 최대 100개까지 가능합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ein Paket pro Zeile ein. Leerzeilen und doppelte Einträge werden entfernt. Höchstens 100 Einträge aus einem Bereich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un paquet par ligne. Les lignes vides et les doublons sont supprimés. Maximum : 100 éléments d’un même périmètre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un paquete por línea. Se eliminan las líneas vacías y los duplicados. Máximo: 100 elementos de un mismo ámbito."
          }
        }
      }
    },
