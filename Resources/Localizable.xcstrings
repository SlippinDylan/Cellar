    "Zsh files may have moved, but the shell configuration changed unexpectedly. It was not overwritten. Review diagnostics before trying again." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh files may have moved, but the shell configuration changed unexpectedly. It was not overwritten. Review diagnostics before trying again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsh 文件可能已移动，但 Shell 配置发生了意外变化，未覆盖配置。请查看诊断后重试。"
