    "Download the official Oh My Zsh installer. Keep the existing .zshrc and login shell; do not launch a new shell." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download the official Oh My Zsh installer. Keep the existing .zshrc and login shell; do not launch a new shell."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载官方 Oh My Zsh 安装器，保留现有 .zshrc 和登录 Shell，不启动新 Shell。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載官方 Oh My Zsh 安裝程式，保留現有 .zshrc 和登入 Shell，不啟動新 Shell。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式の Oh My Zsh インストーラをダウンロードします。既存の .zshrc とログインシェルを保持し、新しいシェルは起動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 Oh My Zsh 설치 프로그램을 다운로드합니다. 기존 .zshrc와 로그인 셸을 유지하며 새 셸을 실행하지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das offizielle Oh-My-Zsh-Installationsprogramm herunterladen. Die vorhandene .zshrc und Anmeldeshell beibehalten; keine neue Shell starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger le programme d’installation officiel d’Oh My Zsh. Conserver le .zshrc existant et le shell de connexion ; ne pas lancer de nouveau shell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar el instalador oficial de Oh My Zsh. Conservar el .zshrc existente y el shell de inicio de sesión; no iniciar un shell nuevo."
          }
        }
      }
    },
    "Download this GitHub repository and enable the plugin. Back up .zshrc and validate its syntax." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download this GitHub repository and enable the plugin. Back up .zshrc and validate its syntax."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载此 GitHub 仓库并启用插件，备份 .zshrc 并检查语法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下載此 GitHub 儲存庫並啟用外掛，備份 .zshrc 並檢查語法。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この GitHub リポジトリをダウンロードし、プラグインを有効にします。.zshrc をバックアップし、構文を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 GitHub 저장소를 다운로드하고 플러그인을 활성화합니다. .zshrc를 백업하고 구문을 검사합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses GitHub-Repository herunterladen und das Plugin aktivieren. .zshrc sichern und die Syntax prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger ce dépôt GitHub et activer le plugin. Sauvegarder .zshrc et vérifier sa syntaxe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar este repositorio de GitHub y activar el complemento. Crear una copia de .zshrc y validar su sintaxis."
          }
        }
      }
    },
    "Each selected Node installation and its global npm packages will be removed. Current and default Node versions are protected." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each selected Node installation and its global npm packages will be removed. Current and default Node versions are protected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将移除每个所选 Node 安装及其 npm 全局包。当前和默认 Node 版本受到保护。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將移除每個所選 Node 安裝及其 npm 全域套件。目前和預設 Node 版本受到保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した各 Node インストールと、その npm グローバルパッケージが削除されます。使用中および既定の Node バージョンは保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 각 Node 설치와 해당 전역 npm 패키지가 제거됩니다. 현재 및 기본 Node 버전은 보호됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede ausgewählte Node-Installation und ihre globalen npm-Pakete werden entfernt. Aktuelle und standardmäßig verwendete Node-Versionen sind geschützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque installation Node sélectionnée et ses paquets npm globaux seront supprimés. Les versions Node actuelles et par défaut sont protégées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán cada instalación de Node seleccionada y sus paquetes globales de npm. Las versiones actuales y predeterminadas de Node están protegidas."
          }
        }
      }
    },
