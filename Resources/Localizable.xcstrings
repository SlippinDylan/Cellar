    "被依赖关系会在卸载计划中实时检查。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependents are checked when preparing the uninstall plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被依赖关系会在卸载计划中实时检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被依賴關係會在解除安裝計畫中即時檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アンインストール計画の準備時に、依存している項目を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 계획을 준비할 때 이 항목에 의존하는 항목을 확인합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängige Pakete werden bei der Vorbereitung des Deinstallationsplans geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets dépendants sont vérifiés lors de la préparation du plan de désinstallation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes que dependen de este se comprueban al preparar el plan de desinstalación."
          }
        }
      }
    },
    "计划会再次读取详情，并用明确类型调用 Homebrew。" : {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan reads details again and calls Homebrew with an explicit type."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划会再次读取详情，并用明确类型调用 Homebrew。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫會再次讀取詳細資訊，並以明確類型呼叫 Homebrew。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画で詳細を再取得し、種別を明示して Homebrew を呼び出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에서 세부 정보를 다시 읽고 명시적인 유형으로 Homebrew를 호출합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan liest die Details erneut ein und ruft Homebrew mit einem expliziten Typ auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan relit les détails et appelle Homebrew avec un type explicite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan vuelve a leer los detalles y llama a Homebrew con un tipo explícito."
          }
        }
      }
    },
