#!/bin/bash
set -u

output=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            shift
            output="${1:-}"
            ;;
    esac
    shift || true
done

if [ -z "$output" ]; then
    printf 'mock curl: missing -o output\n' >&2
    exit 64
fi

cat > "$output" <<'EOF'
#!/bin/sh
exit 0
EOF
exit "${MOCK_CURL_EXIT:-0}"
